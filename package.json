{
  "name": "renderlab",
  "private": true,
  "version": "0.1.0",
  "description": "An interactive lab for frontend rendering strategies: CSR, SSG, ISR, SSR, streaming, RSC and PPR.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "homepage": "https://haris-devo.github.io/renderlab/",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/haris-devo/renderlab.git"
  },
  "author": "Haris Ahmed"
}
